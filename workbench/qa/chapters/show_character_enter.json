          "character": "3C",
          "text": "PRUEBA 1. Samu debe entrar una sola vez desde abajo. Espera a que termine la animación y avanza."
        },
        {
          "actions": [
            {
              "type": "showCharacter",
              "character": "samu",
              "position": "left",
              "pose": "happy",
              "enter": "right"
