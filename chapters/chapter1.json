              "loop": true,
              "id": "furrielva",
              "fadeIn": 500
            },
            {
              "type": "showCharacter",
              "character": "samu",
              "position": "center",
              "pose": "worried"
            }
          ]
        },
        {
          "character": "Samu",
          "text": "Antes había muchas palomas y ahora hay muchos eh... Hombres-paloma.",
          "actions": [
            {
