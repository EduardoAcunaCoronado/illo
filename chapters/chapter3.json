    {
      "title": "Escena 11: Las partituras",
      "lines": [
        {
          "character": "2B",
          "text": "Edu despliega las alas y se lanza al vacío del escenario. Las hojas de partitura flotan por todas partes; entre ellas, focos que caen y cables eléctricos colgando. Hay que recogerlas todas sin electrocutarse."
        },
        {
          "actions": [
            { "type": "hideCharacter", "position": "left" },
            { "type": "pauseSound", "id": "bg_music" },
            { "type": "playSound", "path": "assets/sounds/music/vuelo_edu.mp3", "volume": 0.55, "loop": true, "id": "mg_music", "fadeIn": 400 },
            {
              "type": "minigame",
              "game": "eduvuelo",
              "goal": 8,
              "goalByDelay": { "0": 8, "1": 10, "2": 12 },
              "speed": 5,
              "speedByDelay": { "0": 5, "1": 6, "2": 7.5 },
              "maxHits": 3,
              "maxHitsByDelay": { "0": 3, "1": 3, "2": 2 }
            },
            { "type": "stopSound", "id": "mg_music", "fadeOut": 500 },
            { "type": "resumeSound", "id": "bg_music" }
          ]
        },
        {
          "actions": [
            { "type": "showCharacter", "character": "edu", "position": "right", "pose": "epic" }
          ],
          "character": "Edu",
          "text": "¡Las tengo todas! Toma tus partituras, Tony. ¡A cantar antes de que esto reviente!"
        },
        {
          "actions": [ { "type": "goToScene", "value": "Escena 12: El concierto" } ]
        }
